; Dedicated domain for the original signed Java service installed in /data.
; The package collects real CPU/memory/sysfs statistics for Task Manager.
; Keep these permissions out of the shared system_app domain.
(type rpi_serviceability)
(roletype object_r rpi_serviceability)
(typeattributeset domain (rpi_serviceability))
(typeattributeset appdomain (rpi_serviceability))
(typeattributeset netdomain (rpi_serviceability))

; Equivalent app_domain runtime support, without permissive domains.
(type rpi_serviceability_userfaultfd)
(roletype object_r rpi_serviceability_userfaultfd)
(typetransition rpi_serviceability rpi_serviceability anon_inode "[userfaultfd]" rpi_serviceability_userfaultfd)
(allow rpi_serviceability rpi_serviceability_userfaultfd (anon_inode (create ioctl read)))
(type rpi_serviceability_block_io_uring)
(roletype object_r rpi_serviceability_block_io_uring)
(typetransition rpi_serviceability rpi_serviceability anon_inode "[io_uring]" rpi_serviceability_block_io_uring)
(typetransition rpi_serviceability tmpfs file appdomain_tmpfs)
(allow rpi_serviceability appdomain_tmpfs (file (execute getattr map read write)))
(allow rpi_serviceability appdomain (memfd_file (execute getattr map read write)))

; Read-only hardware statistics, following the original provider's contract.
(allow rpi_serviceability proc_stat (file (getattr open read)))
(allow rpi_serviceability proc_vmstat (file (getattr open read)))
(allow rpi_serviceability proc_cpuinfo (file (getattr open read)))
(allow rpi_serviceability sysfs_type (dir (getattr open read search)))
(allow rpi_serviceability sysfs_type (file (getattr open read)))
(allow rpi_serviceability sysfs_type (lnk_file (getattr read)))
(allow rpi_serviceability app_api_service (service_manager (find)))

; Shared system UID uses system_app_data_file for its own app directory.
(allow rpi_serviceability system_app_data_file (dir (add_name create getattr open read remove_name search setattr write)))
(allow rpi_serviceability system_app_data_file (file (append create getattr ioctl lock map open read rename setattr unlink write)))
(allow rpi_serviceability system_app_data_file (lnk_file (create getattr read unlink)))
